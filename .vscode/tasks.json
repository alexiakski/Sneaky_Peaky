{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar jogo",
            "command": "g++",
            "args": [
                "-g",
                "-Wall",
                "-std=c++17",
                "*.cpp",
                "-I${workspaceFolder}/SFML-2.6.2-linux-gcc-64-bit/SFML-2.6.2/include",
                "-L${workspaceFolder}/SFML-2.6.2-linux-gcc-64-bit/SFML-2.6.2/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-Wl,--disable-new-dtags,-rpath,${workspaceFolder}/SFML-2.6.2-linux-gcc-64-bit/SFML-2.6.2/lib",
                "-o",
                "jogo"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}